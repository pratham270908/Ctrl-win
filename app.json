{
  "expo": {
    "name": "Smart Directional Location Finder",
    "slug": "smart-directional-location-finder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Smart Directional Location Finder to use your location for navigation and nearby place recommendations.",
          "locationWhenInUsePermission": "Allow Smart Directional Location Finder to use your location for navigation and nearby place recommendations."
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.smartdirectional.finder",
      "config": {
        "googleMapsApiKey": "AIzaSyDPsFxq8EsMMKXauVKGly3ToqjYXX1_wCc"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F172A"
      },
      "package": "com.smartdirectional.finder",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDPsFxq8EsMMKXauVKGly3ToqjYXX1_wCc"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}

